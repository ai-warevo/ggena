# ==============================================================================
# GGena Framework Configuration Example
# ==============================================================================

# Model configuration
IMAGE_MODEL_ID="stablediffusionapi/Pony-Diffusion-V6-XL"
ENABLE_TORCH_COMPILE=false # Enable torch.compile for UNet and VAE (requires PyTorch 2.0+)
TEXT_MODEL_ID="huihui-ai/Qwen2.5-7B-Instruct-Uncensored"
IMAGE_GEN_COUNT=3
IMAGE_MAX_BATCH_SIZE=1
IMAGE_EXTRA_REFINEMENT_RULES="- If cinematic lighting is requested, add positive tags: 'volumetric light, raytracing' and negative tags: 'flat lighting, dark, low contrast'."

# Direct Prompt Overrides (if both are set, text expansion is skipped)
IMAGE_POSITIVE_PROMPT=""
IMAGE_NEGATIVE_PROMPT=""

# Baseline global starters
IMAGE_POSITIVE_STARTER="score_9, score_8_up, score_7_up"
IMAGE_NEGATIVE_STARTER="score_4, score_5, score_6, ugly, deformed, blurry, low quality, bad anatomy, bad hands, mutated, disfigured, anime, manga, comic, 2d, 3d, cg, render, illustration, drawing, artwork"

# Base characters constraints
RANDOM_BASE_CHARACTER_TAGS="1man; solo; photorealistic; cinematic portrait"

# Allowed character movements and interactions
RANDOM_ACTIONS="standing, action pose, looking at viewer; sitting on chair, relaxed pose; running, dynamic shot, motion blur; leaning against wall, casual stance"

# Skin rendering, textures, and anatomical details
RANDOM_SKIN_DETAILS="highly detailed skin, skin_texture, pores visible; sharp focus, ultra detailed eyes, hyperrealistic face; windblown hair, detailed textures"

# Camera framing, angles, and anti-collage constraints
RANDOM_CAMERA_ANGLES="portrait, close-up, depth of field; cowboy shot, medium shot; wide shot, full body, heroic stance"

# Environmental lighting setups
RANDOM_LIGHTING="cinematic lighting, soft light; rim lighting, dramatic shadows; studio lighting, soft shadows; sunset lighting, warm tones"

# Background locations and world architecture
RANDOM_ENVIRONMENT="indoor, cyberpunk city, neon glow; nature, forest background, daylight; studio background, solid color background; urban landscape, city streets, night"

# ==============================================================================
# Infrastructure & System Settings
# ==============================================================================

# Hugging Face Authentication
HF_TOKEN="your_token_here"
# [logs] Список ключей, значения которых нужно скрывать в логах (через запятую)
SENSITIVE_KEYS="HF_TOKEN"

# Output settings
OUTPUT_DIR="outputs/image"
DEFAULT_PROMPT="spiderman"

# Server settings
ALLOWED_ORIGINS="http://localhost:3000"
PORT=8000
PRODUCTION=false
NVIDIA_TF32_OVERRIDE=1
