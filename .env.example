# Model configuration
IMAGE_MODEL_ID=stablediffusionapi/Pony-Diffusion-V6-XL
TEXT_MODEL_ID=Qwen/Qwen2.5-1.5B-Instruct
IMAGE_GEN_COUNT=1
IMAGE_EXTRA_REFINEMENT_RULES="- If cinematic lighting is requested, add positive tags: 'volumetric light, raytracing' and negative tags: 'flat lighting, dark, low contrast'."

# Hugging Face Authentication
# Получи его здесь: https://huggingface.co/settings/tokens
HF_TOKEN=your_token_here

# Output settings
OUTPUT_DIR=outputs/image
DEFAULT_PROMPT="лара крофт в шортах"

