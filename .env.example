# Model configuration
IMAGE_MODEL_ID="stablediffusionapi/Pony-Diffusion-V6-XL"
TEXT_MODEL_ID="huihui-ai/Qwen2.5-7B-Instruct-Uncensored"
IMAGE_GEN_COUNT=3
IMAGE_MAX_BATCH_SIZE=1
IMAGE_EXTRA_REFINEMENT_RULES="- If cinematic lighting is requested, add positive tags: 'volumetric light, raytracing' and negative tags: 'flat lighting, dark, low contrast'."

# Direct Prompt Overrides (if both are set, Qwen expansion is skipped)
IMAGE_POSITIVE_PROMPT=""
IMAGE_NEGATIVE_PROMPT=""

# Hugging Face Authentication
# Получи его здесь: https://huggingface.co/settings/tokens
HF_TOKEN="your_token_here"
# Список ключей, значения которых нужно скрывать в логах (через запятую)
SENSITIVE_KEYS="HF_TOKEN"

# Output settings
OUTPUT_DIR="outputs/image"
DEFAULT_PROMPT="лара крофт в шортах"

# Server settings
ALLOWED_ORIGINS="http://localhost:3000"
PORT=8000
PRODUCTION=false

